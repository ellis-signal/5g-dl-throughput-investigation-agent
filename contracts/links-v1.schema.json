{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wireless links input v1",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "case_id",
      "bandwidth_mhz",
      "snr_db",
      "actual_throughput_mbps"
    ],
    "additionalProperties": false,
    "properties": {
      "case_id": {
        "type": "string",
        "minLength": 1
      },
      "bandwidth_mhz": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "snr_db": {
        "type": "number"
      },
      "actual_throughput_mbps": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "$comment": "Unique case_id across array enforced by Python; JSON Schema cannot express property-unique IDs here."
}
