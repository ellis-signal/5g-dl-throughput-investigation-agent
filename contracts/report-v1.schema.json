{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wireless report v1",
  "type": "object",
  "required": [
    "schema_version",
    "method_version",
    "model",
    "source",
    "case_count",
    "verification_status",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "method_version": {
      "const": "shannon-awgn-v1"
    },
    "model": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "case_count": {
      "type": "integer",
      "minimum": 1
    },
    "verification_status": {
      "const": "UNVERIFIED"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "bandwidth_mhz",
          "snr_db",
          "actual_throughput_mbps",
          "capacity_mbps",
          "throughput_to_capacity_ratio"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "bandwidth_mhz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "snr_db": {
            "type": "number"
          },
          "actual_throughput_mbps": {
            "type": "number",
            "minimum": 0
          },
          "capacity_mbps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "throughput_to_capacity_ratio": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  },
  "$comment": "Cross-file checks, case_count equality, unique IDs, sha256 and Shannon recalculation are enforced by Python tools (not this JSON Schema)."
}
